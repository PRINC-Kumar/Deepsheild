APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-32chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./deepshield.db
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_S=60
AUTO_DELETE_UPLOADS_DAYS=30
USE_MOCK_ML=true
ML_MODULE_PATH=
ML_WEIGHTS_PATH=
ML_GRADCAM_LAYER=layer4
ML_LABEL_FAKE_INDEX=1
ML_THRESHOLD=0.5
UNCERTAIN_LOW=0.4
UNCERTAIN_HIGH=0.6
RATE_LIMIT_DETECT_PER_MINUTE=20
UPLOAD_DIR=uploads
HEATMAP_DIR=heatmaps

