# ── DeepShield .env.example ──────────────────────────────────────────────────
# Copy this to .env and fill in your values. Never commit .env to git.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=CHANGE_ME_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./deepshield.db

# ── File limits ──────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_S=60
AUTO_DELETE_UPLOADS_DAYS=30

# ── ML Adapter ───────────────────────────────────────────────────────────────
# Set to true to run without a real model (returns random but valid results)
USE_MOCK_ML=true

# When you have your real model, fill these in and set USE_MOCK_ML=false:
# ML_MODULE_PATH=/absolute/path/to/your/ml/folder
# ML_WEIGHTS_PATH=/absolute/path/to/weights.pth
# ML_GRADCAM_LAYER=layer4          # last conv layer name in your model
# ML_LABEL_FAKE_INDEX=1            # which output index means FAKE
# ML_THRESHOLD=0.5                 # above this → FAKE, below → REAL
# UNCERTAIN_LOW=0.4                # below this confident threshold
# UNCERTAIN_HIGH=0.6               # above this confident threshold

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DETECT_PER_MINUTE=20

# ── Directories ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
HEATMAP_DIR=heatmaps

